# 仅存放本机密钥；请勿将真实密钥提交到 Git 或贴入日志。
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o"

# Agnes Video V2.0（Agent 5 使用）
AGNES_API_KEY=""
AGNES_API_BASE_URL="https://apihub.agnes-ai.com/v1"
AGNES_VIDEO_MODEL="agnes-video-v2.0"
AGNES_VIDEO_WIDTH="720"
AGNES_VIDEO_HEIGHT="1280"
AGNES_VIDEO_FRAME_RATE="24"
AGNES_REQUEST_TIMEOUT_SECONDS="60"
AGNES_POLL_INTERVAL_SECONDS="5"
AGNES_MAX_POLL_SECONDS="900"
AGNES_MAX_REVISIONS="2"
# 0 表示生成所有分镜；开发调试时可设为 1 或 2，避免创建大量任务。
AGNES_MAX_SHOTS_PER_EPISODE="0"

# 默认写入 code/outputs；可设置绝对路径覆盖。
DRAMAMATRIX_OUTPUT_DIR=""
