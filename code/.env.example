# 仅存放本机密钥；请勿将真实密钥提交到 Git 或贴入日志。
# 文本模型：默认沿用 OpenAI。第三方只要兼容 OpenAI Chat Completions API，即可填写
# TEXT_MODEL_BASE_URL、TEXT_MODEL_API_KEY 和 TEXT_MODEL_NAME。
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o"
# TEXT_MODEL_BASE_URL="https://api.example.com/v1"
# TEXT_MODEL_API_KEY=""
# TEXT_MODEL_NAME="provider-model-name"
# 兼容旧变量：OPENAI_BASE_URL / OPENAI_API_BASE 也会被读取。

# Agnes Video V2.0（Agent 5 使用）
AGNES_API_KEY=""
AGNES_API_BASE_URL="https://apihub.agnes-ai.com/v1"
AGNES_VIDEO_MODEL="agnes-video-v2.0"
AGNES_VIDEO_WIDTH="720"
AGNES_VIDEO_HEIGHT="1280"
AGNES_VIDEO_FRAME_RATE="24"
AGNES_REQUEST_TIMEOUT_SECONDS="60"
AGNES_CONNECT_TIMEOUT_SECONDS="10"
AGNES_PREFLIGHT_TIMEOUT_SECONDS="15"
AGNES_POLL_INTERVAL_SECONDS="5"
AGNES_MAX_POLL_SECONDS="900"
# 仅重试轮询和成品下载等 GET 请求；创建视频 POST 仅对"明确拒绝类"安全重试
# （429 限流、503 video_queue_full），其余 5xx/网络中断不自动重试以避免重复扣费。
AGNES_GET_RETRY_ATTEMPTS="5"
AGNES_RETRY_DELAY_SECONDS="2"
AGNES_RETRY_MAX_DELAY_SECONDS="30"
# POST 对 queue_full/429 的安全重试次数与退避上限（30→60→120→240→300s + 抖动）。
AGNES_POST_RETRY_ATTEMPTS="4"
AGNES_QUEUE_RETRY_MAX_SECONDS="300"
# 预检连通性在进程内缓存的秒数，避免 Agent5 每次重入都重检。
AGNES_PREFLIGHT_CACHE_SECONDS="300"
# 条件链式生成：首镜用参考图、后续镜用上一镜尾帧；同场景共享 seed。默认关闭。
DRAMAMATRIX_CONDITIONAL_GENERATION="0"
# 推荐配置长期驻留、支持远程 DNS 的专用代理；留空或 direct 表示直连。
AGNES_PROXY_URL="direct"
AGNES_MAX_REVISIONS="2"
# 0 表示生成所有分镜；开发调试时可设为 1 或 2。受限运行会标记
# render_partial，不会误进入 Agent6；调回 0 后以同一 project-id --resume 可续跑。
AGNES_MAX_SHOTS_PER_EPISODE="0"

# 默认写入 code/outputs；可设置绝对路径覆盖。
DRAMAMATRIX_OUTPUT_DIR=""
# 其他 Agent 使用的可选代理；Agnes 优先读取上面的 AGNES_PROXY_URL。
DRAMAMATRIX_PROXY_URL="direct"
# 同一项目重跑时，从 SQLite 快照的第一个未完成阶段继续；新项目请换一个 ID。
# 可用命令行 --project-id / --resume / --run-mode / --agnes-get-retry-attempts /
# --agnes-retry-delay-seconds 覆盖当前一次运行，无需修改本文件。
DRAMAMATRIX_PROJECT_ID="Drama_20260307_001"
DRAMAMATRIX_RESUME="1"

# ---- 运行模式（R1）----
# production（默认）：任何模拟回退一律阻塞——无书源 blocked_on_source、
# 评审/编剧模型失败 blocked_on_text_model / blocked_on_script、无投放数据
# waiting_for_market_data。修复配置后 --resume 从断点重试。
# demo：显式演示模式。mock 书目、模拟评审、固定回退剧情、模拟投放数据
# 可用，且全部带标记（EvaluationReport.simulated / content_origin=demo_fallback /
# analytics.source='simulated'），不会冒充真实产出。
DRAMAMATRIX_RUN_MODE="production"

# 整剧生产周期上限：Agent 8 产出市场反馈后，是否回到 Agent 1 进行新一轮选品。
# R1：自动换书回环默认关闭——回环会在同一项目、同集键（ep_01...）、同输出
# 路径上开新书，旧书剧集残留/被覆盖。开启（=1）前必须先建立"项目—作品—周期"
# 隔离；仅设 MAX_CYCLES>1 不再触发回环。
DRAMAMATRIX_AUTO_NEXT_CYCLE="0"
DRAMAMATRIX_MAX_CYCLES="1"
# 立项被否时，换书重试的最大尝试次数（超过后流程结束）。
DRAMAMATRIX_MAX_SCOUT_ATTEMPTS="3"

# 分镜与预算门禁（生产模式）。单集分镜数量区间、全剧总镜头预算、
# 是否允许 LLM 失败时用 mock 单镜头兜底（仅调试，生产应保持 0）。
DRAMAMATRIX_MIN_SHOTS_PER_EPISODE="12"
DRAMAMATRIX_MAX_SHOTS_PER_EPISODE="30"
DRAMAMATRIX_MAX_TOTAL_SHOTS="120"
# 受控真实联调：限制集数和每集目标镜头数，避免先生成 8 集×20 镜再截断渲染。
# 生产环境保持 TEST_MODE=0、MAX_EPISODES=0、TARGET_SHOTS_PER_EPISODE=0。
DRAMAMATRIX_TEST_MODE="0"
DRAMAMATRIX_MAX_EPISODES="0"
DRAMAMATRIX_TARGET_SHOTS_PER_EPISODE="0"
DRAMAMATRIX_ALLOW_MOCK_STORYBOARD="0"
DRAMAMATRIX_REVIEW_MODE="background"
DRAMAMATRIX_PUBLISH_EXPORT="1"

# 投流切片导出（G2）：导出切片数（1=仅开场 hook；2=hook+climax）、
# hook 时长、climax 时长（0=继承 hook 时长；climax 锚定最后一镜并缩短不溢出）。
DRAMAMATRIX_GROWTH_CLIP_COUNT="2"
DRAMAMATRIX_GROWTH_CLIP_DURATION="15"
DRAMAMATRIX_GROWTH_CLIMAX_DURATION="0"

# 跨镜连续性质检。严格模式下，ffmpeg/首帧提取/亮度计算失败会触发当前镜重画；
# 非严格模式只告警。阈值越小越敏感。
DRAMAMATRIX_QC_STRICT="0"
DRAMAMATRIX_QC_BRIGHTNESS_THRESHOLD="45"

# 语音方案（G4）：Agnes 原生语音优先，独立 TTS 兜底。
# DRAMAMATRIX_AGNES_VOICE=1 时，对白作为 narration 传给 Agnes（字段名可配，
# 需服务器端验证是否被接受）；Agnes 无声则由下面的独立 TTS 兜底。
DRAMAMATRIX_AGNES_VOICE="0"
AGNES_VOICE_PROMPT_FIELD="voice_prompt"
AGNES_NARRATION_FIELD="narration"
# 独立 TTS：provider 选 edge（edge-tts，免费）/ openai。留空=不启用独立 TTS。
DRAMAMATRIX_TTS_ENABLED="1"
DRAMAMATRIX_TTS_PROVIDER=""
DRAMAMATRIX_TTS_VOICE="zh-CN-XiaoxiaoNeural"
DRAMAMATRIX_TTS_URL=""
DRAMAMATRIX_TTS_API_KEY=""
DRAMAMATRIX_TTS_MODEL="tts-1"
DRAMAMATRIX_TTS_OPENAI_VOICE="alloy"

# 字幕大字报烧录（阶段2）。关闭或缺失 ffmpeg 时成片不带烧录字幕。
DRAMAMATRIX_SUBTITLES_ENABLED="1"
DRAMAMATRIX_SUBTITLE_FONT_SIZE="72"
DRAMAMATRIX_SUBTITLE_COLOR="&H00FFFFFF"
DRAMAMATRIX_SUBTITLE_OUTLINE="&H00000000"

# Agnes 创建次数预算护栏（阶段4）：0 表示不限；>0 达到即熔断新任务。
DRAMAMATRIX_MAX_AGNES_CREATES="0"

# ---- 金额成本账本与预算（R3，价目为估算口径）----
# 单次视频创建的估算费用（每镜一次，重绘也是一次新创建）。未配置/0 时
# 金额护栏休眠（次数护栏 MAX_AGNES_CREATES 仍生效）；配置后：
# 分镜确认时按 剩余镜头数×单价 做预估并检查单集/项目预算（超出则
# storyboard_blocked，COST_ESTIMATE_EXCEEDED），每次付费创建前检查剩余
# 额度，任务落地通过完整性校验后从预留升级为已确认。
# python -m src.cost_report <project_id> 查看单集费用/每分钟成片成本/重绘占比。
DRAMAMATRIX_PRICE_VIDEO_CREATE=""
DRAMAMATRIX_PRICE_TTS_1K_CHARS=""
DRAMAMATRIX_PRICE_IMAGE_CREATE=""
DRAMAMATRIX_EPISODE_BUDGET="0"
DRAMAMATRIX_PROJECT_BUDGET="0"
DRAMAMATRIX_COST_CURRENCY="CNY"

# ---- 语音与整集验收（R2，可靠成片）----
# 对白变速上限：台词超出镜头窗口时按此上限压缩语速；到上限仍放不下则
# 保留完整语音（绝不截断）、标记 overflow 并顺延后续对白。
DRAMAMATRIX_TTS_MAX_SPEED="1.35"
# 整集验收门禁（默认开）：Agent6 合成后暂停为 awaiting_episode_review，
# 人工核片后 python -m src.episode_review <project> <ep> approve|rework。
# 设 0 关闭（合成完成直接进入投流，不推荐生产使用）。
DRAMAMATRIX_EPISODE_REVIEW="1"

# ---- 供应商路由（U1）----
# 视频供应商：agnes（默认）/ dummy（离线演示与集成测试，不需要 AGNES_API_KEY）。
# 未知值会在启动时报错而非静默回落 Agnes。
DRAMAMATRIX_VIDEO_PROVIDER="agnes"

# ---- 图像生成 / 角色参考图（U2）----
# off（默认，不生成参考图）/ dummy（占位图，测试用）/ openai（OpenAI 兼容
# /images/generations，用于生成角色参考图并在场景首镜作为条件输入）。
DRAMAMATRIX_IMAGE_PROVIDER="off"
IMAGE_MODEL_BASE_URL=""
IMAGE_MODEL_API_KEY=""
IMAGE_MODEL_NAME="gpt-image-1"
IMAGE_SIZE="1024x1024"

# ---- 视觉相似度 QC（U3）----
# 上一镜尾帧 vs 当前镜首帧的 dHash 结构相似度，低于阈值记告警；
# DRAMAMATRIX_QC_SIMILARITY_GATE=1 时升级为硬门禁（不合格走重绘）。
DRAMAMATRIX_QC_SIMILARITY_THRESHOLD="0.55"
DRAMAMATRIX_QC_SIMILARITY_GATE="0"

# ---- 创作提示词外置（U5）----
# 默认读取 code/prompts/*.md（agent2_forum / agent3_head_writer /
# agent4_storyboard / agent4_storyboard_recovery / character_bible），
# 文件缺失时回退内置默认。可指向运营自定义目录。
DRAMAMATRIX_PROMPT_DIR=""

# ---- 真实数据源（W2，合规替换 mock）----
# 本地小说库：目录内 *.txt = 一本书（文件名即书名；首行可写 "# tags: 男频,玄幻"）。
# 配置后 Agent1 优先从本地库选书；production 模式未配置时选品阻塞
# （blocked_on_source），demo 模式回退 mock 爬虫。
DRAMAMATRIX_LOCAL_NOVEL_DIR=""
# 投放数据回流：平台导出的 CSV（列 ep_id,views,cpa,completion_rate,tags，
# tags 分号/竖线分隔；platform 可选列如 douyin）或 JSON（同字段数组）。
# production 模式未配置/导入失败时 Agent8 进入等待（waiting_for_market_data）
# 零写入；demo 模式写 source='simulated' 模拟行。同一文件重复导入按
# dedup_key（项目+文件哈希+行号）自动去重。
DRAMAMATRIX_ANALYTICS_IMPORT=""

# ---- 版权与素材权属（W3）----
# 源头小说授权：owned / licensed / public-domain / unknown（未配置记 unknown）。
DRAMAMATRIX_SOURCE_LICENSE=""
DRAMAMATRIX_SOURCE_OWNER=""
DRAMAMATRIX_SOURCE_NOTE=""
# 生成物权利（投放包 publish_meta.json 的 rights 块会携带 AI 内容披露）。
DRAMAMATRIX_ASSET_LICENSE="studio-owned"
DRAMAMATRIX_ASSET_RIGHTS_NOTE=""

# ---- 角色身份质检（W4，Vision-LLM 判官）----
# 开启后逐镜用多模态模型比对【角色参考图 vs 当前首帧】打 0-100 身份一致性分；
# 默认只告警并落库，DRAMAMATRIX_IDENTITY_GATE=1 升级为硬门禁（不合格走重绘）。
DRAMAMATRIX_IDENTITY_QC="0"
DRAMAMATRIX_IDENTITY_THRESHOLD="70"
DRAMAMATRIX_IDENTITY_GATE="0"
# 多模态判官端点（OpenAI 兼容 chat/completions；回落 TEXT_MODEL_* / OPENAI_*）。
IDENTITY_MODEL_BASE_URL=""
IDENTITY_MODEL_API_KEY=""
IDENTITY_MODEL_NAME="gpt-4o-mini"
IDENTITY_TIMEOUT_SECONDS="60"
