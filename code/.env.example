# 仅存放本机密钥；请勿将真实密钥提交到 Git 或贴入日志。
# 文本模型：默认沿用 OpenAI。第三方只要兼容 OpenAI Chat Completions API，即可填写
# TEXT_MODEL_BASE_URL、TEXT_MODEL_API_KEY 和 TEXT_MODEL_NAME。
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o"
# TEXT_MODEL_BASE_URL="https://api.example.com/v1"
# TEXT_MODEL_API_KEY=""
# TEXT_MODEL_NAME="provider-model-name"
# 兼容旧变量：OPENAI_BASE_URL / OPENAI_API_BASE 也会被读取。

# Agnes Video V2.0（Agent 5 使用）
AGNES_API_KEY=""
AGNES_API_BASE_URL="https://apihub.agnes-ai.com/v1"
AGNES_VIDEO_MODEL="agnes-video-v2.0"
AGNES_VIDEO_WIDTH="720"
AGNES_VIDEO_HEIGHT="1280"
AGNES_VIDEO_FRAME_RATE="24"
AGNES_REQUEST_TIMEOUT_SECONDS="60"
AGNES_CONNECT_TIMEOUT_SECONDS="10"
AGNES_PREFLIGHT_TIMEOUT_SECONDS="15"
AGNES_POLL_INTERVAL_SECONDS="5"
AGNES_MAX_POLL_SECONDS="900"
# 仅重试轮询和成品下载等 GET 请求；创建视频 POST 仅对"明确拒绝类"安全重试
# （429 限流、503 video_queue_full），其余 5xx/网络中断不自动重试以避免重复扣费。
AGNES_GET_RETRY_ATTEMPTS="5"
AGNES_RETRY_DELAY_SECONDS="2"
AGNES_RETRY_MAX_DELAY_SECONDS="30"
# POST 对 queue_full/429 的安全重试次数与退避上限（30→60→120→240→300s + 抖动）。
AGNES_POST_RETRY_ATTEMPTS="4"
AGNES_QUEUE_RETRY_MAX_SECONDS="300"
# 预检连通性在进程内缓存的秒数，避免 Agent5 每次重入都重检。
AGNES_PREFLIGHT_CACHE_SECONDS="300"
# 条件链式生成：首镜用参考图、后续镜用上一镜尾帧；同场景共享 seed。默认关闭。
DRAMAMATRIX_CONDITIONAL_GENERATION="0"
# 推荐配置长期驻留、支持远程 DNS 的专用代理；留空或 direct 表示直连。
AGNES_PROXY_URL="direct"
AGNES_MAX_REVISIONS="2"
# 0 表示生成所有分镜；开发调试时可设为 1 或 2。受限运行会标记
# render_partial，不会误进入 Agent6；调回 0 后以同一 project-id --resume 可续跑。
AGNES_MAX_SHOTS_PER_EPISODE="0"

# 默认写入 code/outputs；可设置绝对路径覆盖。
DRAMAMATRIX_OUTPUT_DIR=""
# 其他 Agent 使用的可选代理；Agnes 优先读取上面的 AGNES_PROXY_URL。
DRAMAMATRIX_PROXY_URL="direct"
# 同一项目重跑时，从 SQLite 快照的第一个未完成阶段继续；新项目请换一个 ID。
# 可用命令行 --project-id / --resume / --agnes-get-retry-attempts /
# --agnes-retry-delay-seconds 覆盖当前一次运行，无需修改本文件。
DRAMAMATRIX_PROJECT_ID="Drama_20260307_001"
DRAMAMATRIX_RESUME="1"

# 整剧生产周期上限：Agent 8 产出市场反馈后，是否回到 Agent 1 进行新一轮选品。
# 默认 1（单周期/线性）；设为 >1 开启"市场回环"闭环。
DRAMAMATRIX_MAX_CYCLES="1"
# 立项被否时，换书重试的最大尝试次数（超过后流程结束）。
DRAMAMATRIX_MAX_SCOUT_ATTEMPTS="3"

# 分镜与预算门禁（生产模式）。单集分镜数量区间、全剧总镜头预算、
# 是否允许 LLM 失败时用 mock 单镜头兜底（仅调试，生产应保持 0）。
DRAMAMATRIX_MIN_SHOTS_PER_EPISODE="12"
DRAMAMATRIX_MAX_SHOTS_PER_EPISODE="30"
DRAMAMATRIX_MAX_TOTAL_SHOTS="120"
# 受控真实联调：限制集数和每集目标镜头数，避免先生成 8 集×20 镜再截断渲染。
# 生产环境保持 TEST_MODE=0、MAX_EPISODES=0、TARGET_SHOTS_PER_EPISODE=0。
DRAMAMATRIX_TEST_MODE="0"
DRAMAMATRIX_MAX_EPISODES="0"
DRAMAMATRIX_TARGET_SHOTS_PER_EPISODE="0"
DRAMAMATRIX_ALLOW_MOCK_STORYBOARD="0"

# 投流切片导出（G2）：导出切片数（1=仅开场 hook；2=hook+climax）、
# hook 时长、climax 时长（0=继承 hook 时长；climax 锚定最后一镜并缩短不溢出）。
DRAMAMATRIX_GROWTH_CLIP_COUNT="2"
DRAMAMATRIX_GROWTH_CLIP_DURATION="15"
DRAMAMATRIX_GROWTH_CLIMAX_DURATION="0"

# 跨镜连续性质检。严格模式下，ffmpeg/首帧提取/亮度计算失败会触发当前镜重画；
# 非严格模式只告警。阈值越小越敏感。
DRAMAMATRIX_QC_STRICT="0"
DRAMAMATRIX_QC_BRIGHTNESS_THRESHOLD="45"

# 语音方案（G4）：Agnes 原生语音优先，独立 TTS 兜底。
# DRAMAMATRIX_AGNES_VOICE=1 时，对白作为 narration 传给 Agnes（字段名可配，
# 需服务器端验证是否被接受）；Agnes 无声则由下面的独立 TTS 兜底。
DRAMAMATRIX_AGNES_VOICE="0"
AGNES_VOICE_PROMPT_FIELD="voice_prompt"
AGNES_NARRATION_FIELD="narration"
# 独立 TTS：provider 选 edge（edge-tts，免费）/ openai。留空=不启用独立 TTS。
DRAMAMATRIX_TTS_ENABLED="1"
DRAMAMATRIX_TTS_PROVIDER=""
DRAMAMATRIX_TTS_VOICE="zh-CN-XiaoxiaoNeural"
DRAMAMATRIX_TTS_URL=""
DRAMAMATRIX_TTS_API_KEY=""
DRAMAMATRIX_TTS_MODEL="tts-1"
DRAMAMATRIX_TTS_OPENAI_VOICE="alloy"

# 字幕大字报烧录（阶段2）。关闭或缺失 ffmpeg 时成片不带烧录字幕。
DRAMAMATRIX_SUBTITLES_ENABLED="1"
DRAMAMATRIX_SUBTITLE_FONT_SIZE="72"
DRAMAMATRIX_SUBTITLE_COLOR="&H00FFFFFF"
DRAMAMATRIX_SUBTITLE_OUTLINE="&H00000000"

# Agnes 创建次数预算护栏（阶段4）：0 表示不限；>0 达到即熔断新任务。
DRAMAMATRIX_MAX_AGNES_CREATES="0"
